# =============================================================================
# Bulk Email Sender - Backend Environment Configuration
# =============================================================================
# Copy this template to `.env` in the repository root before starting the backend server.
#
# IMPORTANT:
# - Do NOT commit your actual `.env` file containing sensitive credentials to git.
# - SQLite databases (data/users.db, data/scheduler.db), logs (logs/email-logs.json),
#   and uploads (uploads/) are created automatically on first run.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------------------
# Port for the Node.js / Hono backend HTTP server (default: 3000)
PORT=3000

# Session Encryption Secret
# CRITICAL: Always set a fixed, secure random string (e.g., 32+ random characters).
# If omitted or left empty, the server generates an ephemeral random key at startup,
# causing ALL active user sessions and logins to be invalidated on every server restart.
SESSION_SECRET=replace_with_a_secure_random_string_min_32_chars

# -----------------------------------------------------------------------------
# 2. System-Level Fallback SMTP Configuration (Optional)
# -----------------------------------------------------------------------------
# These credentials serve as a fallback default when an authenticated user has not
# yet registered a custom user SMTP configuration in the `/configs` workspace.
# Note: For Gmail, an App Password with 2-Factor Authentication (2FA) is required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_16_character_app_password
FROM_EMAIL=you@example.com
FROM_NAME=Bulk Email Sender

# -----------------------------------------------------------------------------
# 3. Global Notification SMTP Configuration (Optional)
# -----------------------------------------------------------------------------
# Used by NotificationService to deliver automated campaign completion notifications
# and execution alerts. If omitted, notification emails will fall back to the user's
# active default SMTP configuration.
NOTIFICATION_SMTP_HOST=smtp.gmail.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USER=notify@example.com
NOTIFICATION_SMTP_PASS=your_notification_app_password
NOTIFICATION_FROM_NAME=Campaign Notifier
