# SvelteKit Frontend Configuration
# Copy this file to .env before starting the development server

# Public API Base URL
# In development and production using the same-origin proxy (ADR 0001), this should be /api
PUBLIC_API_BASE_URL=/api

# Private Backend Server Origin (Server-side only)
# Used exclusively by SvelteKit server routes (routes/api/[...path]/+server.ts and lib/server/session.ts)
# to forward requests to the Hono backend server.
# NEVER exposed to the browser.
BACKEND_ORIGIN=http://localhost:3000
