{
  "name": "bulk-email-sender",
  "version": "2.0.0",
  "description": "Web-based bulk email sender with user management and WYSIWYG editor",
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "tsx src/app.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist uploads/* logs/* data/users.db",
    "reset-db": "rm -f data/users.db data/scheduler.db",
    "test": "echo \"No automated tests yet - see detailedplan.md section 11 for the manual verification protocol\" && exit 0"
  },
  "keywords": [
    "email",
    "bulk-email",
    "smtp",
    "nodemailer",
    "typescript",
    "authentication",
    "user-management"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "~1.11.5",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.8.1",
    "csv-stringify": "^6.4.4",
    "dotenv": "^16.3.1",
    "hono": "^3.12.0",
    "nodemailer": "^6.9.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
